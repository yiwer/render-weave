{
  "dslVersion": "renderweave-template/1",
  "name": "场次条",
  "base": { "name": "场次", "version": 1 },
  "artboard": {
    "sizeRange": { "width": { "min": 5, "max": 100 }, "height": { "min": 3, "max": 10 } },
    "minFontSize": 2,
    "layout": { "mode": "stack", "direction": "row", "gap": 2, "alignItems": "center" },
    "children": [
      { "type": "text", "name": "开始时刻", "content": [{ "slot": "startsAt", "format": "HH:mm" }], "font": "res:font-hei-medium", "fontSize": 3.2, "color": "#2B2824" },
      {
        "type": "text", "name": "场次名称", "content": [{ "slot": "title" }], "font": "res:font-hei-medium", "fontSize": 3.2, "color": "#2B2824",
        "place": { "width": "fill" }, "fit": { "steps": ["compressGlyphs", "shrink"], "onFail": "hint" }
      },
      { "type": "text", "name": "会场", "content": [{ "slot": "room" }], "font": "res:font-hei-medium", "fontSize": 3, "color": "#7A7166" }
    ]
  }
}
