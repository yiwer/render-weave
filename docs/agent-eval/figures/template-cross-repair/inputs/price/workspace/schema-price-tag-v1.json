{
  "dslVersion": "renderweave-schema/1",
  "name": "商品价签",
  "version": 1,
  "displayName": "商品价签",
  "description": "超市货架上的一张价签；字段都是扁平的，Excel 导入的价签样例用它",
  "fields": [
    {
      "name": "productName",
      "displayName": "品名",
      "type": "text",
      "constraints": {
        "required": true,
        "minLength": 1,
        "maxLength": 30
      }
    },
    {
      "name": "spec",
      "displayName": "规格",
      "type": "text",
      "constraints": {
        "maxLength": 16
      }
    },
    {
      "name": "unit",
      "displayName": "单位",
      "type": "text",
      "constraints": {
        "required": true,
        "enum": [
          "个",
          "瓶",
          "袋",
          "盒",
          "千克"
        ]
      }
    },
    {
      "name": "origin",
      "displayName": "产地",
      "type": "text",
      "constraints": {
        "maxLength": 12
      }
    },
    {
      "name": "itemNo",
      "displayName": "货号",
      "type": "text",
      "constraints": {
        "required": true,
        "pattern": "^[0-9]{7}$"
      }
    },
    {
      "name": "retailPrice",
      "displayName": "零售价",
      "type": "number",
      "constraints": {
        "required": true,
        "min": 0,
        "max": 99999
      }
    },
    {
      "name": "memberPrice",
      "displayName": "会员价",
      "type": "number",
      "constraints": {
        "min": 0,
        "max": 99999
      }
    },
    {
      "name": "onSale",
      "displayName": "促销",
      "type": "boolean"
    },
    {
      "name": "saleEnds",
      "displayName": "促销截止",
      "type": "date"
    },
    {
      "name": "features",
      "displayName": "卖点",
      "type": "list",
      "items": {
        "type": "text",
        "constraints": {
          "minLength": 1,
          "maxLength": 6
        }
      },
      "constraints": {
        "maxItems": 3
      }
    }
  ]
}
