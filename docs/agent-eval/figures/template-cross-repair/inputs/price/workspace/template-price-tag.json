{
  "dslVersion": "renderweave-template/1",
  "name": "商品价签",
  "base": {
    "name": "商品价签",
    "version": 1
  },
  "parameters": [
    {
      "name": "storeName",
      "displayName": "门店",
      "visibility": "public",
      "type": "text",
      "constraints": {
        "maxLength": 12
      },
      "default": "示例生活超市"
    }
  ],
  "derived": [
    {
      "name": "hasMemberPrice",
      "displayName": "有会员价",
      "type": "boolean",
      "op": "branch",
      "branches": [
        {
          "when": {
            "left": {
              "var": "memberPrice"
            },
            "op": "notEmpty"
          },
          "then": {
            "value": true
          }
        }
      ],
      "otherwise": {
        "value": false
      }
    }
  ],
  "artboard": {
    "sizeRange": {
      "width": {
        "min": 80,
        "max": 120
      },
      "height": {
        "min": 40,
        "max": 60
      }
    },
    "minFontSize": 2,
    "fill": "#FFFFFF",
    "padding": 3,
    "layout": {
      "mode": "stack",
      "direction": "column",
      "gap": 1.2
    },
    "children": [
      {
        "type": "container",
        "name": "抬头",
        "place": {
          "width": "fill"
        },
        "layout": {
          "mode": "stack",
          "direction": "row",
          "gap": 2,
          "alignItems": "center"
        },
        "children": [
          {
            "type": "text",
            "name": "品名",
            "content": [
              {
                "slot": "productName"
              }
            ],
            "font": "res:font-hei-medium",
            "fontSize": 6,
            "color": "#1F1D1A",
            "place": {
              "width": "fill"
            },
            "fit": {
              "steps": [
                "compressGlyphs",
                "shrink"
              ],
              "onFail": "severe"
            }
          },
          {
            "type": "text",
            "name": "促销",
            "visible": {
              "var": "onSale"
            },
            "content": [
              {
                "text": "促销"
              }
            ],
            "font": "res:font-hei-medium",
            "fontSize": 3.5,
            "color": "#C8102E"
          }
        ]
      },
      {
        "type": "text",
        "name": "规格产地",
        "font": "res:font-hei-medium",
        "fontSize": 3,
        "color": "#55504A",
        "place": {
          "width": "fill"
        },
        "content": [
          {
            "text": "规格 "
          },
          {
            "slot": "spec"
          },
          {
            "text": "  单位 "
          },
          {
            "slot": "unit"
          },
          {
            "text": "  产地 "
          },
          {
            "slot": "origin"
          }
        ],
        "fit": {
          "steps": [
            "compressGlyphs",
            "shrink"
          ],
          "onFail": "hint"
        }
      },
      {
        "type": "container",
        "name": "价格",
        "place": {
          "width": "fill",
          "height": "fill"
        },
        "layout": {
          "mode": "stack",
          "direction": "row",
          "gap": 3,
          "alignItems": "end"
        },
        "children": [
          {
            "type": "text",
            "name": "零售价",
            "content": [
              {
                "text": "¥"
              },
              {
                "slot": "retailPrice",
                "format": "0.00"
              }
            ],
            "font": "res:font-hei-medium",
            "fontSize": 12,
            "color": "#C8102E"
          },
          {
            "type": "text",
            "name": "会员价",
            "visible": {
              "var": "hasMemberPrice"
            },
            "content": [
              {
                "text": "会员价 ¥"
              },
              {
                "slot": "memberPrice",
                "format": "0.00"
              }
            ],
            "font": "res:font-hei-medium",
            "fontSize": 3.5,
            "color": "#1F1D1A"
          }
        ],
        "padding": {
          "left": 5
        }
      },
      {
        "type": "loop",
        "name": "卖点行",
        "list": {
          "var": "features"
        },
        "template": "价签卖点",
        "itemLayout": {
          "direction": "row",
          "widths": "content",
          "gap": 1.5
        },
        "place": {
          "width": "fill",
          "height": {
            "fixed": 5
          }
        }
      },
      {
        "type": "container",
        "name": "页脚",
        "place": {
          "width": "fill"
        },
        "layout": {
          "mode": "stack",
          "direction": "row",
          "gap": 3
        },
        "children": [
          {
            "type": "text",
            "name": "货号",
            "content": [
              {
                "text": "货号 "
              },
              {
                "slot": "itemNo"
              }
            ],
            "font": "res:font-hei-medium",
            "fontSize": 2.5,
            "color": "#55504A"
          },
          {
            "type": "text",
            "name": "促销截止",
            "visible": {
              "var": "onSale"
            },
            "content": [
              {
                "text": "促销截止 "
              },
              {
                "slot": "saleEnds",
                "format": "yyyy年M月d日"
              }
            ],
            "font": "res:font-hei-medium",
            "fontSize": 2.5,
            "color": "#C8102E"
          },
          {
            "type": "text",
            "name": "门店",
            "content": [
              {
                "slot": "storeName"
              }
            ],
            "font": "res:font-hei-medium",
            "fontSize": 2.5,
            "color": "#55504A",
            "place": {
              "width": "fill"
            },
            "horizontalAlign": "end"
          }
        ],
        "padding": {
          "left": 2
        }
      }
    ]
  }
}
