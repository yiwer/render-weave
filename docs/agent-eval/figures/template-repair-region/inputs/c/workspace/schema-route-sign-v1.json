{
  "dslVersion": "renderweave-schema/1",
  "name": "线路牌",
  "version": 1,
  "displayName": "线路牌（单线路单方向）",
  "fields": [
    {
      "name": "routeNo",
      "displayName": "线路号",
      "type": "text",
      "constraints": {
        "required": true,
        "minLength": 1,
        "maxLength": 8
      }
    },
    {
      "name": "routeNoImage",
      "displayName": "线路号图片",
      "type": "image",
      "constraints": {
        "allowedSources": [
          "resource"
        ]
      }
    },
    {
      "name": "fareType",
      "displayName": "票制",
      "type": "text",
      "constraints": {
        "maxLength": 10
      }
    },
    {
      "name": "fare",
      "displayName": "票价（元）",
      "type": "number",
      "constraints": {
        "min": 0,
        "max": 100
      }
    },
    {
      "name": "operator",
      "displayName": "运营方",
      "type": "text",
      "constraints": {
        "maxLength": 20
      }
    },
    {
      "name": "firstDeparture",
      "displayName": "首班",
      "type": "time"
    },
    {
      "name": "lastDeparture",
      "displayName": "末班",
      "type": "time"
    },
    {
      "name": "serviceNote",
      "displayName": "运营说明",
      "type": "text",
      "constraints": {
        "maxLength": 20
      }
    },
    {
      "name": "scheduleType",
      "displayName": "班车类型",
      "type": "text",
      "constraints": {
        "maxLength": 10
      }
    },
    {
      "name": "departureTimes",
      "displayName": "班次时刻",
      "type": "list",
      "items": {
        "type": "time"
      },
      "constraints": {
        "maxItems": 60
      }
    },
    {
      "name": "stops",
      "displayName": "停靠站点",
      "type": "list",
      "items": {
        "type": "ref",
        "ref": {
          "name": "停靠站点",
          "version": 1
        }
      },
      "constraints": {
        "required": true,
        "minItems": 2,
        "maxItems": 50
      }
    }
  ]
}
