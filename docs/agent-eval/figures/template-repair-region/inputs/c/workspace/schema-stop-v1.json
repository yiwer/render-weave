{
  "dslVersion": "renderweave-schema/1",
  "name": "停靠站点",
  "version": 1,
  "displayName": "停靠站点",
  "description": "线路在一个行驶方向上依次停靠的站点",
  "fields": [
    {
      "name": "name",
      "displayName": "站名",
      "type": "text",
      "constraints": {
        "required": true,
        "minLength": 1,
        "maxLength": 20
      }
    },
    {
      "name": "landmark",
      "displayName": "地标",
      "type": "image",
      "constraints": {
        "allowedSources": [
          "resource"
        ]
      }
    },
    {
      "name": "road",
      "displayName": "所在道路",
      "type": "text",
      "constraints": {
        "required": true,
        "minLength": 1,
        "maxLength": 12
      }
    },
    {
      "name": "badges",
      "displayName": "站名上方的标识",
      "type": "list",
      "items": {
        "type": "text",
        "constraints": {
          "enum": [
            "地铁",
            "医院"
          ]
        }
      },
      "constraints": {
        "maxItems": 3
      }
    }
  ]
}
