{
  "dslVersion": "renderweave-template/1",
  "name": "班次时刻",
  "base": {
    "name": "单值·时刻",
    "version": 1
  },
  "parameters": [
    {
      "name": "isLast",
      "displayName": "是否末项",
      "visibility": "public",
      "type": "boolean",
      "default": false
    }
  ],
  "artboard": {
    "sizeRange": {
      "width": {
        "min": 3,
        "max": 30
      },
      "height": {
        "min": 4,
        "max": 10
      }
    },
    "size": "hug",
    "layout": {
      "mode": "stack",
      "direction": "row",
      "alignItems": "center"
    },
    "children": [
      {
        "type": "text",
        "name": "时刻",
        "content": [
          {
            "slot": "value",
            "format": "HH:mm"
          }
        ],
        "font": "res:font-hei-medium",
        "fontSize": 5.5,
        "color": "#222222",
        "place": {
          "width": "hug",
          "height": "hug"
        }
      },
      {
        "type": "text",
        "name": "分隔",
        "content": [
          {
            "text": "/"
          }
        ],
        "font": "res:font-hei-medium",
        "fontSize": 5.5,
        "color": "#222222",
        "place": {
          "width": "hug",
          "height": "hug"
        },
        "states": {
          "by": {
            "var": "isLast"
          },
          "cases": {
            "true": {
              "visible": false
            }
          }
        }
      }
    ]
  }
}
