{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "竖版线路牌 v1",
  "x-renderweave-static-schema": {
    "name": "竖版线路牌",
    "version": 1
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "routeNo",
    "serviceStart",
    "serviceEnd",
    "stops"
  ],
  "properties": {
    "routeNo": {
      "title": "线路号",
      "type": "string",
      "minLength": 1,
      "maxLength": 8
    },
    "serviceStart": {
      "title": "服务开始时刻",
      "type": "string",
      "format": "rw-time",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$",
      "x-renderweave-type": "time"
    },
    "serviceEnd": {
      "title": "服务结束时刻",
      "type": "string",
      "format": "rw-time",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$",
      "x-renderweave-type": "time"
    },
    "fare": {
      "title": "票价（元）",
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "stops": {
      "title": "停靠站点",
      "type": "array",
      "minItems": 2,
      "maxItems": 40,
      "items": {
        "x-renderweave-static-schema": {
          "name": "竖版停靠站点",
          "version": 1
        },
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "road"
        ],
        "properties": {
          "name": {
            "title": "站名",
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "road": {
            "title": "所在道路",
            "type": "string",
            "minLength": 1,
            "maxLength": 12
          },
          "facilities": {
            "title": "设施",
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "医院",
                "地铁站",
                "火车站",
                "机场"
              ]
            }
          }
        }
      }
    }
  }
}
