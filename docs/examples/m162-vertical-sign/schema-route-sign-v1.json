{
  "dslVersion": "renderweave-schema/1",
  "name": "竖版线路牌",
  "version": 1,
  "displayName": "竖版线路牌（单线路单方向）",
  "description": "站台竖版线路牌：线路号、服务时间、票价与按行驶方向排列的停靠站点",
  "fields": [
    {
      "name": "routeNo",
      "displayName": "线路号",
      "type": "text",
      "constraints": {
        "required": true,
        "minLength": 1,
        "maxLength": 8
      }
    },
    {
      "name": "serviceStart",
      "displayName": "服务开始时刻",
      "type": "time",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "serviceEnd",
      "displayName": "服务结束时刻",
      "type": "time",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "fare",
      "displayName": "票价（元）",
      "type": "number",
      "constraints": {
        "min": 0,
        "max": 100
      }
    },
    {
      "name": "stops",
      "displayName": "停靠站点",
      "type": "list",
      "items": {
        "type": "ref",
        "ref": {
          "name": "竖版停靠站点",
          "version": 1
        }
      },
      "constraints": {
        "required": true,
        "minItems": 2,
        "maxItems": 40
      }
    }
  ]
}
