{
  "dslVersion": "renderweave-template/1",
  "name": "竖版站点行",
  "base": { "name": "竖版停靠站点", "version": 1 },

  "parameters": [
    {
      "name": "index", "displayName": "站点序号", "visibility": "public", "type": "number",
      "constraints": { "integer": true, "min": 1 }, "default": 1
    },
    {
      "name": "currentIndex", "displayName": "本站序号", "visibility": "public", "type": "number",
      "constraints": { "integer": true, "min": 0 }, "default": 0
    },
    {
      "name": "nameSize", "displayName": "站名字号", "visibility": "public", "type": "number",
      "constraints": { "min": 5, "max": 30 }, "default": 14.3
    }
  ],

  "derived": [
    {
      "name": "isCurrent", "displayName": "是本站", "type": "boolean", "op": "branch",
      "branches": [
        { "when": { "left": { "var": "index" }, "op": "eq", "right": { "var": "currentIndex" } }, "then": { "value": true } }
      ],
      "otherwise": { "value": false }
    },
    {
      "name": "facilityText", "displayName": "设施类别", "type": "text",
      "op": "pickItem", "list": { "var": "facilities" }, "position": "first"
    },
    {
      "name": "facilityCount", "displayName": "设施数量", "type": "number",
      "op": "length", "of": { "var": "facilities" }
    },
    {
      "name": "hasFacility", "displayName": "有设施", "type": "boolean", "op": "branch",
      "branches": [
        { "when": { "left": { "var": "facilityCount" }, "op": "gt", "right": { "value": 0 } }, "then": { "value": true } }
      ],
      "otherwise": { "value": false }
    },
    {
      "name": "nameLength", "displayName": "站名长度", "type": "number",
      "op": "length", "of": { "var": "name" }
    },
    {
      "name": "roadLength", "displayName": "道路名长度", "type": "number",
      "op": "length", "of": { "var": "road" }
    },
    {
      "name": "nameAndRoadLength", "displayName": "站名与道路名总长", "type": "number",
      "op": "add", "left": { "var": "nameLength" }, "right": { "var": "roadLength" }
    },
    {
      "name": "labelChars", "displayName": "整行字符数", "type": "number",
      "op": "add", "left": { "var": "nameAndRoadLength" }, "right": { "value": 2 }
    },
    {
      "name": "labelBase", "displayName": "站名行自然宽", "type": "number",
      "op": "multiply", "left": { "var": "labelChars" }, "right": { "var": "nameSize" }
    },
    {
      "name": "labelRaw", "displayName": "底板宽（含边距）", "type": "number",
      "op": "add", "left": { "var": "labelBase" }, "right": { "value": 12 }
    },
    {
      "name": "labelWidth", "displayName": "底板宽", "type": "number", "op": "branch",
      "branches": [
        { "when": { "left": { "var": "labelRaw" }, "op": "gt", "right": { "value": 228 } }, "then": { "value": 228 } }
      ],
      "otherwise": { "var": "labelRaw" }
    }
  ],

  "artboard": {
    "sizeRange": { "width": { "min": 50, "max": 300 }, "height": { "min": 10, "max": 40 } },
    "layout": { "mode": "stack", "direction": "row", "alignItems": "center", "gap": 2.2 },
    "children": [
      {
        "type": "container",
        "name": "站名底板",
        "layout": { "mode": "stack", "direction": "row", "alignItems": "center" },
        "place": { "width": { "fixed": { "var": "labelWidth" } }, "height": "fill" },
        "states": {
          "by": { "var": "isCurrent" },
          "cases": { "true": { "fill": "#FFF000" } }
        },
        "children": [
          {
            "type": "text",
            "name": "站名",
            "content": [
              { "slot": "name" },
              { "text": "（" },
              { "slot": "road" },
              { "text": "）" }
            ],
            "font": "res:font-hei-medium",
            "fontSize": { "var": "nameSize" },
            "color": "#FFFFFF",
            "verticalAlign": "center",
            "padding": { "left": 5.5, "right": 5.5 },
            "fit": { "steps": ["compressGlyphs"], "compressMin": 0.6, "onFail": "severe" },
            "place": { "width": "fill", "height": "fill" },
            "states": {
              "by": { "var": "isCurrent" },
              "cases": {
                "true": { "color": "#0154A4", "font": "res:font-hei-bold" }
              }
            }
          }
        ]
      },
      {
        "type": "image",
        "name": "设施图标",
        "source": "res:facility-hospital",
        "fit": "contain",
        "visible": { "var": "hasFacility" },
        "place": { "width": { "fixed": 10.5 }, "height": { "fixed": 11 } },
        "states": {
          "by": { "var": "facilityText" },
          "cases": {
            "医院": { "source": "res:facility-hospital" },
            "地铁站": { "source": "res:facility-metro" },
            "火车站": { "source": "res:facility-railway" },
            "机场": { "source": "res:facility-airport" }
          }
        }
      }
    ]
  }
}
