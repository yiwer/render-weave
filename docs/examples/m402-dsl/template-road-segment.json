{
  "dslVersion": "renderweave-template/1",
  "name": "道路段",
  "base": { "name": "停靠站点", "version": 1 },

  "parameters": [
    { "name": "isFirst", "displayName": "是否首项", "visibility": "public", "type": "boolean", "default": false },
    { "name": "roadTextColor", "displayName": "道路文字颜色", "visibility": "internal", "type": "color", "default": "#1E5BB8" },
    { "name": "separatorColor", "displayName": "分隔线颜色", "visibility": "internal", "type": "color", "default": "#555555" }
  ],

  "artboard": {
    "sizeRange": { "width": { "min": 5, "max": 800 }, "height": { "min": 8, "max": 14 } },
    "layout": { "mode": "stack", "direction": "row", "alignItems": "center" },
    "children": [
      {
        "type": "rect",
        "name": "分隔线",
        "fill": { "var": "separatorColor" },
        "place": { "width": { "fixed": 0.4 }, "height": { "fixed": 6 } },
        "states": {
          "by": { "var": "isFirst" },
          "cases": { "true": { "visible": false } }
        }
      },
      {
        "type": "text",
        "name": "道路名",
        "content": [{ "slot": "road" }],
        "horizontalAlign": "spaceEvenly",
        "verticalAlign": "center",
        "font": "res:font-hei-medium",
        "fontSize": 6.5,
        "color": { "var": "roadTextColor" },
        "fit": {
          "steps": ["compressGlyphs", "shrink"],
          "compressMin": 0.6,
          "minFontSize": 5,
          "onFail": "severe"
        },
        "padding": { "left": 2, "right": 2 },
        "place": { "width": "fill", "height": "fill" }
      }
    ]
  }
}
