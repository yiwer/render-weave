{
  "dslVersion": "renderweave-template/1",
  "name": "站点格",
  "base": { "name": "停靠站点", "version": 1 },
  "parameters": [
    { "name": "index", "displayName": "本站序号", "visibility": "public", "type": "number" },
    { "name": "currentIndex", "displayName": "当前站序号", "visibility": "public", "type": "number" }
  ],
  "derived": [
    {
      "name": "isCurrent",
      "displayName": "是否当前站",
      "type": "boolean",
      "op": "branch",
      "branches": [
        { "when": { "left": { "var": "index" }, "op": "eq", "right": { "var": "currentIndex" } }, "then": { "value": true } }
      ],
      "otherwise": { "value": false }
    },
    {
      "name": "isPassed",
      "displayName": "是否已过站",
      "type": "boolean",
      "op": "branch",
      "branches": [
        { "when": { "left": { "var": "index" }, "op": "lt", "right": { "var": "currentIndex" } }, "then": { "value": true } }
      ],
      "otherwise": { "value": false }
    },
    {
      "name": "hasLandmark",
      "displayName": "有地标",
      "type": "boolean",
      "op": "branch",
      "branches": [
        { "when": { "left": { "var": "landmark" }, "op": "notEmpty" }, "then": { "value": true } }
      ],
      "otherwise": { "value": false }
    },
    {
      "name": "passedKey",
      "displayName": "非当前站状态键",
      "type": "text",
      "op": "branch",
      "branches": [
        { "when": { "left": { "var": "isPassed" }, "op": "eq", "right": { "value": true } }, "then": { "value": "passed" } }
      ],
      "otherwise": { "value": "future" }
    },
    {
      "name": "nameState",
      "displayName": "站名状态",
      "type": "text",
      "op": "branch",
      "branches": [
        { "when": { "left": { "var": "isCurrent" }, "op": "eq", "right": { "value": true } }, "then": { "value": "current" } }
      ],
      "otherwise": { "var": "passedKey" }
    }
  ],
  "artboard": {
    "sizeRange": { "width": { "min": 8, "max": 400 }, "height": { "min": 60, "max": 120 } },
    "layout": { "mode": "stack", "direction": "column", "gap": 0, "alignItems": "center" },
    "padding": { "top": 6 },
    "children": [
      {
        "type": "loop",
        "name": "标识列",
        "place": { "width": "hug", "height": { "fixed": 10 } },
        "list": { "var": "badges" },
        "template": "站点标识",
        "args": {},
        "itemLayout": { "direction": "row", "widths": "content", "gap": 0.6 }
      },
      {
        "type": "container",
        "name": "站名框",
        "place": { "width": "fill", "height": "fill" },
        "layout": {
          "mode": "grid",
          "rows": [ { "fraction": 1 }, { "fixed": 11 } ],
          "columns": [ { "fraction": 1 }, { "fixed": 9.5 }, { "fraction": 1 } ],
          "rowGap": 0,
          "columnGap": 0
        },
        "children": [
          {
            "type": "rect",
            "name": "当前站黄条",
            "place": { "row": 1, "column": 2, "rowSpan": 2 },
            "fill": "#FFEC00",
            "visible": { "var": "isCurrent" }
          },
          {
            "type": "container",
            "name": "站名位",
            "place": { "row": 1, "column": 1, "columnSpan": 3 },
            "layout": { "mode": "free" },
            "padding": { "top": 1, "bottom": 1 },
            "states": {
              "by": { "var": "hasLandmark" },
              "cases": {
                "true": { "padding": { "top": 1, "bottom": 12 } }
              }
            },
            "children": [
              {
                "type": "text",
                "name": "站名",
                "place": { "left": 0, "top": 0, "width": "fill", "height": "fill" },
                "content": [ { "slot": "name" } ],
                "font": "res:font-hei-medium",
                "fontSize": 9,
                "color": "#1A1A1A",
                "writingMode": "vertical",
                "horizontalAlign": "center",
                "verticalAlign": "distribute",
                "fit": { "steps": ["tightenSpacing", "compressGlyphs"], "compressMin": 0.6 },
                "states": {
                  "by": { "var": "nameState" },
                  "cases": {
                    "passed": { "color": "#ABABAB" },
                    "current": { "color": "#E60012" }
                  }
                }
              }
            ]
          },
          {
            "type": "image",
            "name": "地标",
            "place": { "row": 2, "column": 1, "columnSpan": 3 },
            "source": { "var": "landmark" },
            "fit": "contain",
            "states": {
              "by": { "var": "nameState" },
              "cases": {
                "passed": { "opacity": 0.45 }
              }
            }
          }
        ]
      }
    ]
  }
}
