{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "胸牌 v1",
  "x-renderweave-static-schema": {
    "name": "胸牌",
    "version": 1
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fullName",
    "role",
    "badgeNo",
    "eventDate"
  ],
  "properties": {
    "fullName": {
      "title": "姓名",
      "type": "string",
      "minLength": 1,
      "maxLength": 12
    },
    "organization": {
      "title": "单位",
      "type": "string",
      "maxLength": 30
    },
    "role": {
      "title": "身份",
      "type": "string",
      "enum": [
        "嘉宾",
        "讲者",
        "工作人员",
        "参会者"
      ]
    },
    "badgeNo": {
      "title": "证件号",
      "type": "string",
      "pattern": "^[A-Z]{2}[0-9]{4}$"
    },
    "photo": {
      "title": "照片",
      "type": "string",
      "pattern": "^res:[A-Za-z0-9][A-Za-z0-9_-]*$",
      "x-renderweave-type": "image"
    },
    "seat": {
      "title": "座位排号",
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "eventDate": {
      "title": "会议日期",
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
      "x-renderweave-type": "date"
    },
    "issuedAt": {
      "title": "发证时间",
      "type": "string",
      "format": "rw-datetime",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]) ([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$",
      "x-renderweave-type": "datetime"
    },
    "vip": {
      "title": "贵宾通道",
      "type": "boolean"
    },
    "mainSession": {
      "title": "主场次",
      "x-renderweave-static-schema": {
        "name": "场次",
        "version": 1
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "startsAt"
      ],
      "properties": {
        "title": {
          "title": "场次名称",
          "type": "string",
          "maxLength": 20
        },
        "startsAt": {
          "title": "开始时刻",
          "type": "string",
          "format": "rw-time",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$",
          "x-renderweave-type": "time"
        },
        "room": {
          "title": "会场",
          "type": "string",
          "maxLength": 10
        }
      }
    },
    "sessions": {
      "title": "参会场次",
      "type": "array",
      "maxItems": 6,
      "items": {
        "x-renderweave-static-schema": {
          "name": "场次",
          "version": 1
        },
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "startsAt"
        ],
        "properties": {
          "title": {
            "title": "场次名称",
            "type": "string",
            "maxLength": 20
          },
          "startsAt": {
            "title": "开始时刻",
            "type": "string",
            "format": "rw-time",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$",
            "x-renderweave-type": "time"
          },
          "room": {
            "title": "会场",
            "type": "string",
            "maxLength": 10
          }
        }
      }
    },
    "tags": {
      "title": "标签",
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "maxLength": 4
      }
    }
  }
}
