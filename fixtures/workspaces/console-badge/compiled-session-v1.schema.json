{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "场次 v1",
  "x-renderweave-static-schema": {
    "name": "场次",
    "version": 1
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "startsAt"
  ],
  "properties": {
    "title": {
      "title": "场次名称",
      "type": "string",
      "maxLength": 20
    },
    "startsAt": {
      "title": "开始时刻",
      "type": "string",
      "format": "rw-time",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$",
      "x-renderweave-type": "time"
    },
    "room": {
      "title": "会场",
      "type": "string",
      "maxLength": 10
    }
  }
}
