{
  "dslVersion": "renderweave-schema/1",
  "name": "胸牌",
  "version": 1,
  "displayName": "会议胸牌",
  "description": "一位参会者的胸牌；九种字段类型都用到了，出图控制台的表单与浏览器测试用它",
  "fields": [
    {
      "name": "fullName",
      "displayName": "姓名",
      "type": "text",
      "constraints": {
        "required": true,
        "minLength": 1,
        "maxLength": 12
      }
    },
    {
      "name": "organization",
      "displayName": "单位",
      "type": "text",
      "constraints": {
        "maxLength": 30
      }
    },
    {
      "name": "role",
      "displayName": "身份",
      "type": "text",
      "constraints": {
        "required": true,
        "enum": [
          "嘉宾",
          "讲者",
          "工作人员",
          "参会者"
        ]
      }
    },
    {
      "name": "badgeNo",
      "displayName": "证件号",
      "type": "text",
      "constraints": {
        "required": true,
        "pattern": "^[A-Z]{2}[0-9]{4}$"
      }
    },
    {
      "name": "photo",
      "displayName": "照片",
      "type": "image",
      "constraints": {
        "allowedSources": [
          "resource"
        ]
      }
    },
    {
      "name": "seat",
      "displayName": "座位排号",
      "type": "number",
      "constraints": {
        "integer": true,
        "min": 1,
        "max": 200
      }
    },
    {
      "name": "eventDate",
      "displayName": "会议日期",
      "type": "date",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "issuedAt",
      "displayName": "发证时间",
      "type": "datetime"
    },
    {
      "name": "vip",
      "displayName": "贵宾通道",
      "type": "boolean"
    },
    {
      "name": "mainSession",
      "displayName": "主场次",
      "type": "ref",
      "ref": {
        "name": "场次",
        "version": 1
      }
    },
    {
      "name": "sessions",
      "displayName": "参会场次",
      "type": "list",
      "items": {
        "type": "ref",
        "ref": {
          "name": "场次",
          "version": 1
        }
      },
      "constraints": {
        "maxItems": 6
      }
    },
    {
      "name": "tags",
      "displayName": "标签",
      "type": "list",
      "items": {
        "type": "text",
        "constraints": {
          "maxLength": 4
        }
      },
      "constraints": {
        "maxItems": 3
      }
    }
  ]
}
