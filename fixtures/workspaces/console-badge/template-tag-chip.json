{
  "dslVersion": "renderweave-template/1",
  "name": "标签块",
  "base": { "name": "单值·文本", "version": 1 },
  "parameters": [
    { "name": "accent", "displayName": "强调色", "visibility": "public", "type": "color", "default": "#B4532A" }
  ],
  "artboard": {
    "sizeRange": { "width": { "min": 2, "max": 40 }, "height": { "min": 2, "max": 10 } },
    "size": "hug",
    "minFontSize": 2,
    "layout": { "mode": "stack", "direction": "row", "alignItems": "center" },
    "padding": { "left": 1.5, "right": 1.5, "top": 0.5, "bottom": 0.5 },
    "fill": "#F6E6DC",
    "stroke": { "color": { "var": "accent" }, "width": 0.3 },
    "cornerRadius": 1.5,
    "children": [
      { "type": "text", "name": "标签文字", "content": [{ "slot": "value" }], "font": "res:font-hei-medium", "fontSize": 3, "color": { "var": "accent" } }
    ]
  }
}
