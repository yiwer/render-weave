{
  "name": "renderweave",
  "version": "0.1.0",
  "private": true,
  "description": "RenderWeave 渲染引擎：数据定义、模板与数据集到图片",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "renderweave": "dist/bin.js"
  },
  "scripts": {
    "fetch-fonts": "node scripts/fetch-fonts.mjs",
    "pretest": "node scripts/fetch-fonts.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "render": "tsx src/bin.ts"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "@xmldom/xmldom": "0.9.12",
    "ajv": "8.20.0",
    "canvaskit-wasm": "0.42.0",
    "css-tree": "3.2.1"
  },
  "devDependencies": {
    "@types/css-tree": "3.2.0",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
