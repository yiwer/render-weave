{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:renderweave:dsl:1:data-definition",
  "title": "RenderWeave 数据定义（renderweave-schema/1，DSL 1.0）",
  "description": "数据定义描述一类图上随业务变化的信息。本 Schema 只检查结构；约束冲突、正则合法性、字段名称重复、引用是否存在等语义检查由引擎完成，见 docs/dsl/data-definition.md「Schema 之外的检查」。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dslVersion",
    "name",
    "fields"
  ],
  "properties": {
    "dslVersion": {
      "const": "renderweave-schema/1"
    },
    "name": {
      "$ref": "#/$defs/nonBlank",
      "description": "数据定义名称，可用中文；发布后与版本号一起标识静态数据定义"
    },
    "version": {
      "$ref": "#/$defs/version",
      "description": "可省略；发布时自动分配为同名的最大版本加 1，写明时必须等于该值"
    },
    "displayName": {
      "$ref": "#/$defs/nonBlank",
      "description": "显示名称，省略时取 name"
    },
    "description": {
      "type": "string"
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      }
    }
  },
  "$defs": {
    "nonBlank": {
      "type": "string",
      "pattern": "\\S"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "fieldName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "description": "英文字母开头，只含字母、数字与下划线（M89）；中文写在 displayName"
    },
    "staticSchemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "required": {
      "type": "boolean",
      "description": "必填；只能写在字段上，列表元素不能写"
    },
    "textConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "$ref": "#/$defs/required"
        },
        "minLength": {
          "$ref": "#/$defs/count"
        },
        "maxLength": {
          "$ref": "#/$defs/count"
        },
        "pattern": {
          "type": "string",
          "description": "ECMAScript 正则，按 Unicode 模式解释"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "numberConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "$ref": "#/$defs/required"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "integer": {
          "type": "boolean"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "imageConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "$ref": "#/$defs/required"
        },
        "allowedSources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "resource",
              "url"
            ]
          },
          "description": "省略时两种来源都允许"
        }
      }
    },
    "listConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "$ref": "#/$defs/required"
        },
        "minItems": {
          "$ref": "#/$defs/count"
        },
        "maxItems": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "plainConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "$ref": "#/$defs/required"
        }
      }
    },
    "valueRules": {
      "description": "按 type 约束 constraints、items 与 ref 的写法；字段与列表元素共用",
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "constraints": {
                "$ref": "#/$defs/textConstraints"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "number"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "constraints": {
                "$ref": "#/$defs/numberConstraints"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "image"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "constraints": {
                "$ref": "#/$defs/imageConstraints"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "list"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "items"
            ],
            "properties": {
              "constraints": {
                "$ref": "#/$defs/listConstraints"
              }
            }
          },
          "else": {
            "type": "object",
            "not": {
              "type": "object",
              "required": [
                "items"
              ]
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "date",
                  "time",
                  "datetime",
                  "boolean",
                  "ref"
                ]
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "constraints": {
                "$ref": "#/$defs/plainConstraints"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "ref"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "ref"
            ]
          },
          "else": {
            "type": "object",
            "not": {
              "type": "object",
              "required": [
                "ref"
              ]
            }
          }
        }
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "displayName",
        "type"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/fieldName"
        },
        "displayName": {
          "$ref": "#/$defs/nonBlank"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "number",
            "date",
            "time",
            "datetime",
            "boolean",
            "image",
            "list",
            "ref"
          ]
        },
        "constraints": {
          "type": "object"
        },
        "items": {
          "$ref": "#/$defs/listItem"
        },
        "ref": {
          "$ref": "#/$defs/staticSchemaRef"
        }
      },
      "$ref": "#/$defs/valueRules"
    },
    "listItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "text",
            "number",
            "date",
            "time",
            "datetime",
            "boolean",
            "image",
            "ref"
          ],
          "description": "列表的元素不能又是列表（M33）"
        },
        "constraints": {
          "type": "object",
          "not": {
            "type": "object",
            "required": [
              "required"
            ]
          }
        },
        "ref": {
          "$ref": "#/$defs/staticSchemaRef"
        }
      },
      "$ref": "#/$defs/valueRules"
    }
  }
}
