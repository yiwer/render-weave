{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "线路牌 v1",
  "x-renderweave-static-schema": { "name": "线路牌", "version": 1 },
  "type": "object",
  "additionalProperties": false,
  "required": ["routeNo", "stops"],
  "properties": {
    "routeNo": { "title": "线路号", "type": "string", "minLength": 1, "maxLength": 8 },
    "routeNoImage": {
      "title": "线路号图片",
      "type": "string",
      "pattern": "^res:[A-Za-z0-9][A-Za-z0-9_-]*$",
      "x-renderweave-type": "image"
    },
    "fareType": { "title": "票制", "type": "string", "maxLength": 10 },
    "fare": { "title": "票价（元）", "type": "number", "minimum": 0, "maximum": 100 },
    "operator": { "title": "运营方", "type": "string", "maxLength": 20 },
    "firstDeparture": {
      "title": "首班",
      "type": "string",
      "format": "rw-time",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$",
      "x-renderweave-type": "time"
    },
    "lastDeparture": {
      "title": "末班",
      "type": "string",
      "format": "rw-time",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$",
      "x-renderweave-type": "time"
    },
    "serviceNote": { "title": "运营说明", "type": "string", "maxLength": 20 },
    "scheduleType": { "title": "班车类型", "type": "string", "maxLength": 10 },
    "departureTimes": {
      "title": "班次时刻",
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "string",
        "format": "rw-time",
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$",
        "x-renderweave-type": "time"
      }
    },
    "stops": {
      "title": "停靠站点",
      "type": "array",
      "minItems": 2,
      "maxItems": 50,
      "items": {
        "x-renderweave-static-schema": { "name": "停靠站点", "version": 1 },
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "road"],
        "properties": {
          "name": { "title": "站名", "type": "string", "minLength": 1, "maxLength": 20 },
          "landmark": {
            "title": "地标",
            "type": "string",
            "pattern": "^res:[A-Za-z0-9][A-Za-z0-9_-]*$",
            "x-renderweave-type": "image"
          },
          "road": { "title": "所在道路", "type": "string", "minLength": 1, "maxLength": 12 },
          "badges": {
            "title": "站名上方的标识",
            "type": "array",
            "maxItems": 3,
            "items": { "type": "string", "enum": ["地铁", "医院"] }
          }
        }
      }
    }
  }
}
