{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "固定资产标识卡 v1",
  "x-renderweave-static-schema": {
    "name": "固定资产标识卡",
    "version": 1
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "company",
    "assetName",
    "assetNo",
    "detailUrl"
  ],
  "properties": {
    "company": {
      "title": "单位名称",
      "type": "string",
      "minLength": 1,
      "maxLength": 10
    },
    "companyLogo": {
      "title": "单位标识",
      "type": "string",
      "pattern": "^res:[A-Za-z0-9][A-Za-z0-9_-]*$",
      "x-renderweave-type": "image"
    },
    "assetName": {
      "title": "资产名称",
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "assetNo": {
      "title": "资产编号",
      "type": "string",
      "pattern": "^[A-Z]{2}-[A-Z0-9]{2,6}-[0-9]{6}$"
    },
    "department": {
      "title": "使用部门",
      "type": "string",
      "maxLength": 12
    },
    "keeper": {
      "title": "保管人",
      "type": "string",
      "maxLength": 8
    },
    "startDate": {
      "title": "启用日期",
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
      "x-renderweave-type": "date"
    },
    "location": {
      "title": "存放地点",
      "type": "string",
      "maxLength": 16
    },
    "detailUrl": {
      "title": "资产详情链接",
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    }
  }
}
