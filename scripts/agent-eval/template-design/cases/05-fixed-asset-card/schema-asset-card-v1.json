{
  "dslVersion": "renderweave-schema/1",
  "name": "固定资产标识卡",
  "version": 1,
  "displayName": "固定资产标识卡",
  "description": "贴在一件固定资产上的标识卡；单位名称与标识随数据集给出",
  "fields": [
    { "name": "company", "displayName": "单位名称", "type": "text", "constraints": { "required": true, "minLength": 1, "maxLength": 10 } },
    { "name": "companyLogo", "displayName": "单位标识", "type": "image", "constraints": { "allowedSources": ["resource"] } },
    { "name": "assetName", "displayName": "资产名称", "type": "text", "constraints": { "required": true, "minLength": 1, "maxLength": 16 } },
    { "name": "assetNo", "displayName": "资产编号", "type": "text", "constraints": { "required": true, "pattern": "^[A-Z]{2}-[A-Z0-9]{2,6}-[0-9]{6}$" } },
    { "name": "department", "displayName": "使用部门", "type": "text", "constraints": { "maxLength": 12 } },
    { "name": "keeper", "displayName": "保管人", "type": "text", "constraints": { "maxLength": 8 } },
    { "name": "startDate", "displayName": "启用日期", "type": "date" },
    { "name": "location", "displayName": "存放地点", "type": "text", "constraints": { "maxLength": 16 } },
    { "name": "detailUrl", "displayName": "资产详情链接", "description": "二维码内容，由资产系统按编号生成", "type": "text", "constraints": { "required": true, "minLength": 1, "maxLength": 120 } }
  ]
}
