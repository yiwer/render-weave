{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "地铁导乘图 v1",
  "x-renderweave-static-schema": {
    "name": "地铁导乘图",
    "version": 1
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lineNo",
    "stations"
  ],
  "properties": {
    "lineNo": {
      "title": "线路号",
      "type": "string",
      "minLength": 1,
      "maxLength": 4
    },
    "firstTrain": {
      "title": "首班",
      "type": "string",
      "format": "rw-time",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$",
      "x-renderweave-type": "time"
    },
    "lastTrain": {
      "title": "末班",
      "type": "string",
      "format": "rw-time",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$",
      "x-renderweave-type": "time"
    },
    "stations": {
      "title": "车站",
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "x-renderweave-static-schema": {
          "name": "导乘站点",
          "version": 1
        },
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "title": "站名",
            "type": "string",
            "minLength": 1,
            "maxLength": 8
          },
          "nameEn": {
            "title": "英文站名",
            "type": "string",
            "maxLength": 36
          },
          "transfers": {
            "title": "换乘线路",
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string",
              "enum": [
                "2号线",
                "4号线",
                "9号线",
                "14号线"
              ]
            }
          }
        }
      }
    }
  }
}
