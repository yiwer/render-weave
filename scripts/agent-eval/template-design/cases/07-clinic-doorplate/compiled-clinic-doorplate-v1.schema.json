{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "诊室门牌 v1",
  "x-renderweave-static-schema": {
    "name": "诊室门牌",
    "version": 1
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hospital",
    "department",
    "room",
    "doctorName",
    "session"
  ],
  "properties": {
    "hospital": {
      "title": "医院",
      "type": "string",
      "minLength": 1,
      "maxLength": 12
    },
    "department": {
      "title": "科室",
      "type": "string",
      "minLength": 1,
      "maxLength": 12
    },
    "room": {
      "title": "诊室",
      "type": "string",
      "minLength": 1,
      "maxLength": 6
    },
    "doctorName": {
      "title": "医生姓名",
      "type": "string",
      "minLength": 2,
      "maxLength": 4
    },
    "doctorTitle": {
      "title": "职称",
      "type": "string",
      "enum": [
        "主任医师",
        "副主任医师",
        "主治医师",
        "住院医师"
      ]
    },
    "doctorPhoto": {
      "title": "医生照片",
      "type": "string",
      "pattern": "^res:[A-Za-z0-9][A-Za-z0-9_-]*$",
      "x-renderweave-type": "image"
    },
    "specialties": {
      "title": "擅长",
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 6
      }
    },
    "session": {
      "title": "出诊时段",
      "type": "string",
      "enum": [
        "上午",
        "下午",
        "晚间"
      ]
    },
    "sessionStart": {
      "title": "出诊开始",
      "type": "string",
      "format": "rw-time",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$",
      "x-renderweave-type": "time"
    },
    "sessionEnd": {
      "title": "出诊结束",
      "type": "string",
      "format": "rw-time",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$",
      "x-renderweave-type": "time"
    },
    "currentTicket": {
      "title": "正在就诊号码",
      "type": "string",
      "pattern": "^[A-Z][0-9]{3}$"
    },
    "currentName": {
      "title": "正在就诊患者",
      "type": "string",
      "maxLength": 6
    },
    "queue": {
      "title": "候诊队列",
      "type": "array",
      "maxItems": 6,
      "items": {
        "x-renderweave-static-schema": {
          "name": "候诊患者",
          "version": 1
        },
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ticket",
          "name",
          "status"
        ],
        "properties": {
          "ticket": {
            "title": "号码",
            "type": "string",
            "pattern": "^[A-Z][0-9]{3}$"
          },
          "name": {
            "title": "患者显示名",
            "type": "string",
            "minLength": 1,
            "maxLength": 6
          },
          "note": {
            "title": "备注",
            "type": "string",
            "maxLength": 4
          },
          "status": {
            "title": "状态",
            "type": "string",
            "enum": [
              "候诊中",
              "准备",
              "过号"
            ]
          }
        }
      }
    },
    "notice": {
      "title": "温馨提示",
      "type": "string",
      "maxLength": 30
    },
    "checkinUrl": {
      "title": "签到二维码内容",
      "type": "string",
      "maxLength": 120
    }
  }
}
