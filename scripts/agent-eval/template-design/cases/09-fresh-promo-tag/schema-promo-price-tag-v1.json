{
  "dslVersion": "renderweave-schema/1",
  "name": "生鲜促销价签",
  "version": 1,
  "displayName": "生鲜散装称重促销价签",
  "description": "限时促销的散装称重商品价签；价格都是每个计价单位的价格",
  "fields": [
    { "name": "storeName", "displayName": "门店名称", "type": "text", "constraints": { "required": true, "minLength": 1, "maxLength": 10 } },
    { "name": "productName", "displayName": "品名", "type": "text", "constraints": { "required": true, "minLength": 1, "maxLength": 30 } },
    { "name": "features", "displayName": "卖点", "type": "list", "items": { "type": "text", "constraints": { "minLength": 1, "maxLength": 6 } }, "constraints": { "maxItems": 3 } },
    { "name": "origin", "displayName": "产地", "type": "text", "constraints": { "maxLength": 12 } },
    { "name": "grade", "displayName": "等级", "type": "text", "constraints": { "maxLength": 6 } },
    { "name": "spec", "displayName": "规格", "type": "text", "constraints": { "maxLength": 12 } },
    { "name": "itemNo", "displayName": "编码", "type": "text", "constraints": { "required": true, "pattern": "^[0-9]{6}$" } },
    { "name": "unit", "displayName": "计价单位", "type": "text", "constraints": { "required": true, "minLength": 1, "maxLength": 6 } },
    { "name": "originalPrice", "displayName": "原价（元）", "type": "number", "constraints": { "min": 0, "max": 9999.99 } },
    { "name": "promoPrice", "displayName": "促销价（元）", "type": "number", "constraints": { "required": true, "min": 0, "max": 9999.99 } },
    { "name": "memberPrice", "displayName": "会员专享价（元）", "type": "number", "constraints": { "min": 0, "max": 9999.99 } },
    { "name": "barcode", "displayName": "店内码", "description": "EAN-13 完整编号，含校验位", "type": "text", "constraints": { "required": true, "pattern": "^[0-9]{13}$" } },
    { "name": "traceUrl", "displayName": "溯源二维码内容", "type": "text", "constraints": { "maxLength": 120 } },
    { "name": "priceChecker", "displayName": "物价员", "type": "text", "constraints": { "maxLength": 8 } },
    { "name": "supervisePhone", "displayName": "监督电话", "type": "text", "constraints": { "maxLength": 16 } }
  ]
}
