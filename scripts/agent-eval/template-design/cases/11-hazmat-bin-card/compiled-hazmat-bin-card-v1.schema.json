{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "危化品库位卡 v1",
  "x-renderweave-static-schema": {
    "name": "危化品库位卡",
    "version": 1
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nameCn",
    "signalWord",
    "location",
    "hazards",
    "barcode"
  ],
  "properties": {
    "nameCn": {
      "title": "中文品名",
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "nameEn": {
      "title": "英文品名",
      "type": "string",
      "maxLength": 40
    },
    "signalWord": {
      "title": "信号词",
      "type": "string",
      "enum": [
        "危险",
        "警告"
      ]
    },
    "location": {
      "title": "库位",
      "type": "string",
      "minLength": 1,
      "maxLength": 14
    },
    "hazards": {
      "title": "危险性类别",
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "enum": [
          "易燃液体",
          "刺激性",
          "健康危害",
          "腐蚀性"
        ]
      }
    },
    "casNo": {
      "title": "CAS 号",
      "type": "string",
      "pattern": "^[0-9]{2,7}-[0-9]{2}-[0-9]$"
    },
    "unNo": {
      "title": "UN 编号",
      "type": "string",
      "pattern": "^UN [0-9]{4}$"
    },
    "lotNo": {
      "title": "批次号",
      "type": "string",
      "maxLength": 20
    },
    "netContent": {
      "title": "净含量",
      "type": "string",
      "maxLength": 12
    },
    "storedOn": {
      "title": "入库日期",
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
      "x-renderweave-type": "date"
    },
    "expiresOn": {
      "title": "有效期至",
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
      "x-renderweave-type": "date"
    },
    "precautions": {
      "title": "安全措施",
      "type": "string",
      "maxLength": 60
    },
    "emergencyPhone": {
      "title": "应急电话",
      "type": "string",
      "maxLength": 30
    },
    "barcode": {
      "title": "库位条码",
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    }
  }
}
