{
  "dslVersion": "renderweave-schema/1",
  "name": "危化品库位卡",
  "version": 1,
  "displayName": "危险化学品安全与库位标识卡",
  "description": "一个库位上一种化学品一个批次的标识卡",
  "fields": [
    { "name": "nameCn", "displayName": "中文品名", "type": "text", "constraints": { "required": true, "minLength": 1, "maxLength": 16 } },
    { "name": "nameEn", "displayName": "英文品名", "type": "text", "constraints": { "maxLength": 40 } },
    { "name": "signalWord", "displayName": "信号词", "type": "text", "constraints": { "required": true, "enum": ["危险", "警告"] } },
    { "name": "location", "displayName": "库位", "type": "text", "constraints": { "required": true, "minLength": 1, "maxLength": 14 } },
    { "name": "hazards", "displayName": "危险性类别", "type": "list",
      "items": { "type": "text", "constraints": { "enum": ["易燃液体", "刺激性", "健康危害", "腐蚀性"] } }, "constraints": { "required": true, "minItems": 1, "maxItems": 4 } },
    { "name": "casNo", "displayName": "CAS 号", "type": "text", "constraints": { "pattern": "^[0-9]{2,7}-[0-9]{2}-[0-9]$" } },
    { "name": "unNo", "displayName": "UN 编号", "type": "text", "constraints": { "pattern": "^UN [0-9]{4}$" } },
    { "name": "lotNo", "displayName": "批次号", "type": "text", "constraints": { "maxLength": 20 } },
    { "name": "netContent", "displayName": "净含量", "type": "text", "constraints": { "maxLength": 12 } },
    { "name": "storedOn", "displayName": "入库日期", "type": "date" },
    { "name": "expiresOn", "displayName": "有效期至", "type": "date" },
    { "name": "precautions", "displayName": "安全措施", "type": "text", "constraints": { "maxLength": 60 } },
    { "name": "emergencyPhone", "displayName": "应急电话", "type": "text", "constraints": { "maxLength": 30 } },
    { "name": "barcode", "displayName": "库位条码", "type": "text", "constraints": { "required": true, "minLength": 1, "maxLength": 24 } }
  ]
}
