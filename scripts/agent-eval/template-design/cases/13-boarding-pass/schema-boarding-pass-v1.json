{
  "dslVersion": "renderweave-schema/1",
  "name": "登机牌",
  "version": 1,
  "displayName": "登机牌（主券加副券，一位旅客一个航段）",
  "fields": [
    { "name": "airline", "displayName": "航空公司", "type": "text", "constraints": { "required": true, "minLength": 1, "maxLength": 8 } },
    { "name": "airlineEn", "displayName": "航空公司英文名", "type": "text", "constraints": { "maxLength": 24 } },
    { "name": "passengerNameEn", "displayName": "旅客拼音姓名", "type": "text", "constraints": { "required": true, "minLength": 1, "maxLength": 28 } },
    { "name": "passengerNameCn", "displayName": "旅客中文姓名", "type": "text", "constraints": { "maxLength": 6 } },
    { "name": "passengerNameShort", "displayName": "副券缩写姓名", "type": "text", "constraints": { "maxLength": 16 } },
    { "name": "ffNo", "displayName": "常旅客号", "type": "text", "constraints": { "maxLength": 16 } },
    { "name": "originCity", "displayName": "出发城市", "type": "text", "constraints": { "required": true, "minLength": 1, "maxLength": 8 } },
    { "name": "originCode", "displayName": "出发三字码", "type": "text", "constraints": { "required": true, "pattern": "^[A-Z]{3}$" } },
    { "name": "destCity", "displayName": "到达城市", "type": "text", "constraints": { "required": true, "minLength": 1, "maxLength": 8 } },
    { "name": "destCode", "displayName": "到达三字码", "type": "text", "constraints": { "required": true, "pattern": "^[A-Z]{3}$" } },
    { "name": "flightNo", "displayName": "航班号", "type": "text", "constraints": { "required": true, "pattern": "^[A-Z0-9]{2}[0-9]{3,4}$" } },
    { "name": "flightDate", "displayName": "航班日期", "type": "date", "constraints": { "required": true } },
    { "name": "boardingTime", "displayName": "登机时间", "type": "time" },
    { "name": "cabinCode", "displayName": "舱位代码", "type": "text", "constraints": { "required": true, "pattern": "^[A-Z]$" } },
    { "name": "cabinName", "displayName": "舱位名称", "type": "text", "constraints": { "required": true, "enum": ["头等舱", "公务舱", "经济舱"] } },
    { "name": "gate", "displayName": "登机口", "type": "text", "constraints": { "maxLength": 4 } },
    { "name": "seat", "displayName": "座位", "type": "text", "constraints": { "required": true, "pattern": "^[0-9]{2,3}[A-K]$" } },
    { "name": "seqNo", "displayName": "登机序号", "type": "text", "constraints": { "pattern": "^[0-9]{3}$" } },
    { "name": "priority", "displayName": "优先登机", "type": "boolean" },
    { "name": "ticketNo", "displayName": "电子客票号", "description": "条码内容", "type": "text", "constraints": { "required": true, "pattern": "^[0-9]{13,14}$" } },
    { "name": "stubQr", "displayName": "副券二维码内容", "type": "text", "constraints": { "maxLength": 120 } }
  ]
}
